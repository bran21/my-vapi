{
  "openapi": "3.0.0",
  "info": {
    "title": "Airdrop & Task Intelligence API",
    "version": "1.0.0",
    "description": "Live daily crypto airdrops and task intelligence feed paid via x402."
  },
  "paths": {
    "/api/airdrops": {
      "get": {
        "summary": "Get latest crypto airdrops and active tasks",
        "responses": {
          "200": {
            "description": "Successful response with active airdrop data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "airdrops": { "type": "array" }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment Required (x402 protocol)"
          }
        }
      }
    }
  }
}
